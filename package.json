{
  "name": "visionary-image-js",
  "version": "1.0.0",
  "description": "Framework-agnostic client-side enhancement for Visionary images with blurhash placeholders.",
  "type": "module",
  "main": "./dist/visionary-image-js.cjs",
  "module": "./dist/visionary-image-js.js",
  "types": "./dist/visionary-image-js.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/visionary-image-js.d.ts",
        "default": "./dist/visionary-image-js.js"
      },
      "require": {
        "types": "./dist/visionary-image-js.d.cts",
        "default": "./dist/visionary-image-js.cjs"
      }
    },
    "./autoload": {
      "import": {
        "types": "./dist/autoload.d.ts",
        "default": "./dist/visionary-autoload.js"
      },
      "require": {
        "types": "./dist/autoload.d.cts",
        "default": "./dist/visionary-autoload.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "autoload": [
        "./dist/autoload.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/visionary-autoload.js",
    "./dist/visionary-autoload.cjs"
  ],
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc --noEmit && vite build && vite build --config vite.config.autoload.ts",
    "clean": "rimraf dist/",
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "types:validate": "attw --pack ."
  },
  "dependencies": {
    "blurhash-url": "^1.4.0",
    "fast-blurhash": "1.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.58.11",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^29.1.1",
    "rimraf": "5.0.10",
    "typescript": "5.5.4",
    "unplugin-dts": "^1.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visionary-ux/visionary-image-js.git"
  },
  "homepage": "https://github.com/visionary-ux/visionary-image-js#readme",
  "packageManager": "pnpm@11.5.1",
  "license": "ISC",
  "keywords": [
    "blurhash",
    "image",
    "placeholder",
    "vanilla-js",
    "visionary"
  ]
}
